<?xml version="1.0"?>
<ruleset name="Kefallinos Hybrid">
	<description>Coding standards for the Kefallinos Hybrid theme.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/src/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cik-hybrid"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cik_hybrid"/>
				<element value="CIK_HYBRID"/>
			</property>
		</properties>
	</rule>

	<!--
	Components and block render files are included from inside a function
	(load_template() / WP_Block::render()), so their variables are local.
	Top-level templates run in global scope and keep the prefix.
	-->
	<!-- Core looks for "<script>.asset.php" next to block scripts. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/blocks/*/*.asset.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/components/*</exclude-pattern>
		<exclude-pattern>/blocks/*/render.php</exclude-pattern>
	</rule>
</ruleset>

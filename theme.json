{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "44rem",
      "wideSize": "76rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#ffffff" },
        { "slug": "surface", "name": "Surface", "color": "#f5f6f8" },
        { "slug": "ink", "name": "Ink", "color": "#15171c" },
        { "slug": "muted", "name": "Muted", "color": "#545b68" },
        { "slug": "line", "name": "Line", "color": "#dfe2e8" },
        { "slug": "brand", "name": "Brand", "color": "#0088cc" },
        { "slug": "brand-tint", "name": "Brand tint", "color": "#e6f4fb" },
        { "slug": "brand-bright", "name": "Brand bright (on dark)", "color": "#1ba3e6" },
        { "slug": "accent", "name": "Accent", "color": "#006fa6" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#004f78" },
        { "slug": "night", "name": "Night", "color": "#0a0a0b" },
        { "slug": "night-card", "name": "Night card", "color": "#111113" },
        { "slug": "night-line", "name": "Night line", "color": "#2a2a30" },
        { "slug": "night-ink", "name": "Night ink", "color": "#f5f5f3" },
        { "slug": "night-muted", "name": "Night muted", "color": "#9d9da6" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "\"Inter Variable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
        },
        {
          "slug": "display",
          "name": "Bricolage Grotesque",
          "fontFamily": "\"Bricolage Grotesque Variable\", \"Inter Variable\", ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "mono",
          "name": "System mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "name": "Small", "size": "0.875rem" },
        { "slug": "canvas", "name": "Canvas", "size": "1rem" },
        { "slug": "lg", "name": "Large", "size": "1.125rem" },
        { "slug": "xl", "name": "Extra large", "size": "1.25rem" },
        { "slug": "3xl", "name": "Heading", "size": "1.875rem" },
        { "slug": "5xl", "name": "Display", "size": "3rem" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "2", "name": "0.5rem", "size": "0.5rem" },
        { "slug": "4", "name": "1rem", "size": "1rem" },
        { "slug": "6", "name": "1.5rem", "size": "1.5rem" },
        { "slug": "10", "name": "2.5rem", "size": "2.5rem" },
        { "slug": "16", "name": "4rem", "size": "4rem" }
      ]
    }
  }
}

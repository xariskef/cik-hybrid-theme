{
  "name": "cik-hybrid-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kefallinos Hybrid: a classic WordPress theme with Tailwind CSS via Vite and optional React islands.",
  "author": "Cikefallinos (https://cikefallinos.com)",
  "license": "UNLICENSED",
